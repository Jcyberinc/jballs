# Build an Eclipse project for Windows 7 and run it in a QEMU VM.
#
#   win7 install          first boot, from the Windows ISO (one-time)
#   win7 start            boot the installed VM
#   win7 stop             graceful ACPI shutdown
#   win7 status           is it running?
#   win7 export [dir]     compile the project, jar it, push it to the VM
#   win7 snapshot <name>  save a qcow2 snapshot
#   win7 restore <name>   roll back to one
#
# Files reach the guest on a virtual CD rebuilt by `export`. A CD is used rather
# than a shared folder because Windows re-reads a disc the moment the media
# changes, so an export lands in a running VM without a reboot -- and it needs
# no Samba on the host and no drivers in the guest.
#
# Graphics: plain std VGA, deliberately. QXL was tried and reverted -- it made
# the guest display glitch. It bought little anyway: Windows 7 only ever gets
# the XDDM qxl driver (qxldod/viogpudo WDDM start at Windows 8), so Aero can
# never engage, and there is no 3D acceleration for a Win7 guest at all.
#
# Audio: Intel HD Audio (ich6). Windows 7 ships that driver in-box, unlike
# AC97, so sound works with no guest install. PipeWire is the host backend.
#
# Host/guest clipboard runs over qemu-vdagent on a virtio-serial port. That is
# the SPICE agent protocol without a SPICE server, so the plain GTK window gets
# shared copy/paste; the guest side is spice-guest-tools, on the share disc.
# mouse=off because usb-tablet already gives an absolute pointer.
#
# The jar is compiled with --release 8 because Windows 7 can only run Java 8;
# the host JDK 25 would emit class files no Win7 JRE can load. module-info.java
# is skipped: JPMS doesn't exist in 8 and a classpath jar has no use for it.
#
# Dependencies are read from the project's Eclipse .classpath, so the IDE build
# and this one cannot drift. Everything except the JavaFX SDK jars is unpacked
# into the jar, because run.bat launches it with `java -jar`, which ignores any
# -cp. JavaFX is deliberately left out: the guest's Liberica "Full" JRE ships
# its own Java 8 build of it, and shipping a second copy -- especially one built
# for Linux -- would only shadow it. The host compiles against the matching
# JavaFX 8 from ~/.local/share/liberica-jdk8, so an API Windows 7 lacks now
# fails at build time instead of in the guest.

set -uo pipefail

VM_DIR="$HOME/VMs/win7"
DISK="$VM_DIR/win7.qcow2"
SHARE_DIR="$VM_DIR/share"
SHARE_ISO="$VM_DIR/share.iso"
MONITOR="$VM_DIR/monitor.sock"
PIDFILE="$VM_DIR/win7.pid"
LOG="$VM_DIR/qemu.log"
WIN_ISO="${WIN7_ISO:-$HOME/Downloads/Win7_Ult_SP1_English_x64.iso}"
PROJECT="${WIN7_PROJECT:-$HOME/jballs}"

die() { echo "win7: $*" >&2; exit 1; }
note() { echo "win7: $*"; }

running() {
  [[ -f $PIDFILE ]] || return 1
  local pid; pid=$(<"$PIDFILE") || return 1
  [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null
}

# HMP over the monitor socket. A lone newline after the command flushes it, and
# the short timeout keeps a wedged VM from hanging the caller.
monitor_cmd() {
  running || return 1
  printf '%s\n' "$1" | timeout 5 socat - "UNIX-CONNECT:$MONITOR" 2>/dev/null
}

qemu_args() {
  # i440fx rather than q35: every controller Windows 7 needs a driver for
  # (PIIX IDE, UHCI, e1000, std VGA) is then one it ships in-box, so Setup
  # runs with no extra driver disk.
  printf '%s\n' \
    -name "Windows 7" \
    -machine pc,accel=kvm \
    -cpu host \
    -smp 2 \
    -m 4096 \
    -rtc base=localtime \
    -vga std \
    -display gtk \
    -audiodev pipewire,id=snd0 \
    -device intel-hda \
    -device hda-duplex,audiodev=snd0 \
    -usb \
    -device usb-tablet \
    -netdev user,id=net0 \
    -device e1000,netdev=net0 \
    -device virtio-serial-pci \
    -chardev qemu-vdagent,id=vdagent,name=vdagent,clipboard=on,mouse=off \
    -device virtserialport,chardev=vdagent,name=com.redhat.spice.0 \
    -drive "file=$DISK,if=ide,index=0,media=disk,format=qcow2" \
    -drive "file=$SHARE_ISO,if=ide,index=3,media=cdrom,id=share,readonly=on" \
    -monitor "unix:$MONITOR,server,nowait" \
    -pidfile "$PIDFILE"
}

launch() {
  local extra=("$@")
  mapfile -t base < <(qemu_args)
  rm -f "$MONITOR"
  setsid qemu-system-x86_64 "${base[@]}" "${extra[@]}" >"$LOG" 2>&1 &
  sleep 3
  running && note "started (pid $(<"$PIDFILE"))" || { tail -5 "$LOG" >&2; die "failed to start -- see $LOG"; }
}

build_share_iso() {
  [[ -d $SHARE_DIR ]] || die "missing $SHARE_DIR"
  # -J/-R so long, mixed-case filenames survive; the label is what shows up as
  # the drive name in Explorer.
  xorriso -as mkisofs -quiet -J -R -V WIN7SHARE -o "$SHARE_ISO" "$SHARE_DIR" 2>&1 | grep -vi '^xorriso' 
  [[ -s $SHARE_ISO ]] || die "failed to build $SHARE_ISO"
}

# Swap the disc in a running VM. Windows notices the media change on its own.
refresh_share() {
  running || return 0
  monitor_cmd "change share $SHARE_ISO" >/dev/null
  note "swapped the share disc in the running VM"
}

detect_main_class() {
  local src="$1" f pkg cls found=()
  while IFS= read -r f; do
    grep -qE 'public +static +void +main *\(' "$f" || continue
    pkg=$(grep -m1 -E '^[[:space:]]*package[[:space:]]+' "$f" \
          | sed -E 's/^[[:space:]]*package[[:space:]]+([A-Za-z0-9_.]+)[[:space:]]*;.*/\1/')
    cls=$(basename "$f" .java)
    if [[ -n $pkg ]]; then found+=("$pkg.$cls"); else found+=("$cls"); fi
  done < <(find "$src" -name '*.java' ! -name 'module-info.java')
  printf '%s\n' "${found[@]}"
}

cmd_export() {
  local project="${1:-$PROJECT}"
  local main="${WIN7_MAIN:-}"
  project=${project%/}
  [[ -d $project ]] || die "no such project: $project"

  local src="$project/src"
  [[ -d $src ]] || src="$project"
  local name; name=$(basename "$project")

  if [[ -z $main ]]; then
    mapfile -t mains < <(detect_main_class "$src")
    case ${#mains[@]} in
      0) die "no class with a main method under $src" ;;
      1) main="${mains[0]}" ;;
      *) die "several main classes (${mains[*]}); pick one with WIN7_MAIN=<fqcn> win7 export" ;;
    esac
  fi

  local build; build=$(mktemp -d)
  trap 'rm -rf "$build"' RETURN

  mapfile -t sources < <(find "$src" -name '*.java' ! -name 'module-info.java')
  [[ ${#sources[@]} -gt 0 ]] || die "no .java sources under $src"

  # Compile against exactly the jars Eclipse uses, straight out of .classpath.
  local -a cp_entries=() bundle=()
  local lib
  while IFS= read -r lib; do
    [[ -n $lib ]] || continue
    [[ $lib == /* ]] || lib="$project/$lib"
    [[ -f $lib ]] || { note "skipping missing lib: $lib"; continue; }
    cp_entries+=("$lib")
    # JavaFX is compile-only -- see the note at the top of this script. Matched
    # by filename so it holds for a JavaFX SDK jar set and a JDK 8 jfxrt.jar
    # alike.
    case "${lib##*/}" in
      jfxrt.jar | javafx*.jar) ;;
      *) bundle+=("$lib") ;;
    esac
  done < <(sed -n 's/.*kind="lib"[^>]*path="\([^"]*\)".*/\1/p' "$project/.classpath" 2>/dev/null)

  local -a cpflag=()
  if ((${#cp_entries[@]})); then
    local cp; cp=$(IFS=:; printf '%s' "${cp_entries[*]}")
    cpflag=(-cp "$cp")
  fi

  # Fold the runtime jars in first, so the compiler's output lands on top of
  # them and project classes always win. Signature files are dropped: they stop
  # matching the moment the archive is repacked.
  local dep out
  for dep in "${bundle[@]}"; do
    # unzip prints "caution: excluded filename not matched" for any -x pattern
    # that hits nothing, which is the normal case for an unsigned jar. Hold the
    # output and only show it if the unpack actually failed.
    if ! out=$(unzip -qo "$dep" -d "$build" \
      -x 'META-INF/*.SF' 'META-INF/*.DSA' 'META-INF/*.RSA' 'META-INF/MANIFEST.MF' 'module-info.class' 2>&1); then
      printf '%s\n' "$out" >&2
      die "failed to unpack $dep"
    fi
  done
  ((${#bundle[@]})) && note "bundled ${#bundle[@]} dependency jar(s)"

  note "compiling ${#sources[@]} source(s) for Java 8, main class $main"
  javac --release 8 -nowarn "${cpflag[@]}" -d "$build" "${sources[@]}" || die "compile failed"

  # Eclipse copies non-source files sitting in the source tree into the output;
  # match that so images and .properties files still resolve at runtime.
  (cd "$src" && find . -type f ! -name '*.java' -exec cp --parents {} "$build/" \;) 2>/dev/null

  jar --create --file "$SHARE_DIR/$name.jar" --main-class "$main" -C "$build" . \
    || die "jar failed"

  cat >"$SHARE_DIR/run.bat" <<BAT
@echo off
rem Launch $name.jar. Three things this has to work around:
rem
rem  * FXGL writes logs\\ and system\\fxgl.bundle relative to the working
rem    directory, so it cannot run from the read-only CD. The jar is copied to
rem    %LOCALAPPDATA% and run from there.
rem  * The VM has no 3D acceleration at all -- plain std VGA, and Windows 7
rem    never gets a WDDM driver -- so JavaFX is forced onto its software
rem    pipeline. The Direct3D one it prefers does not exist here.
rem  * A BellSoft Liberica "Full" JRE is required: stock OpenJDK 8 builds
rem    (Adoptium included) ship no JavaFX and FXGL cannot start without it.
rem    BellSoft is checked before PATH so a leftover Adoptium cannot win.
setlocal
set "JAVA="
set "JFX="
for /d %%D in ("%ProgramFiles%\\BellSoft\\*") do (
  if exist "%%D\\bin\\java.exe" (
    set "JAVA=%%D\\bin\\java.exe"
    if exist "%%D\\jre\\lib\\ext\\jfxrt.jar" set "JFX=1"
    if exist "%%D\\lib\\ext\\jfxrt.jar" set "JFX=1"
  )
)
if not defined JAVA (
  where java >nul 2>&1 && set "JAVA=java"
)
if not defined JAVA (
  echo No Java found -- install bellsoft-jre8u504-full.msi from this disc first.
  pause
  exit /b 1
)
if not defined JFX (
  echo.
  echo   WARNING: this Java has no JavaFX - jfxrt.jar was not found next to it.
  echo   FXGL cannot start without it. Install bellsoft-jre8u504-full.msi from
  echo   this disc; Adoptium/Temurin JRE 8 does NOT bundle JavaFX.
  echo.
)
set "WORK=%LOCALAPPDATA%\\$name"
if not exist "%WORK%" mkdir "%WORK%"
copy /y "%~dp0$name.jar" "%WORK%\\$name.jar" >nul
set "LOG=%WORK%\\run.log"
echo Java: %JAVA%
echo Work: %WORK%
echo.
pushd "%WORK%"
"%JAVA%" -Dprism.order=sw -Dprism.verbose=true -jar "$name.jar" > "%LOG%" 2>&1
set "RC=%ERRORLEVEL%"
popd
echo Exit code: %RC%
echo ---------------------- output ----------------------
type "%LOG%"
echo ----------------------------------------------------
echo Saved to %LOG%
pause
BAT

  # cmd.exe parses multi-line for/if blocks unreliably out of a file with Unix
  # line endings, and run.bat now uses them. Ship it as CRLF.
  sed -i 's/\r*$/\r/' "$SHARE_DIR/run.bat"

  build_share_iso
  note "exported $name.jar ($(du -h "$SHARE_DIR/$name.jar" | cut -f1)) -> $SHARE_ISO"
  refresh_share
  note "in the VM: open the WIN7SHARE disc and run run.bat"
}

cmd_install() {
  running && die "already running -- 'win7 stop' first"
  [[ -f $WIN_ISO ]] || die "Windows ISO not found: $WIN_ISO"
  [[ -f $SHARE_ISO ]] || build_share_iso
  note "booting the Windows 7 installer; install to the 60G disk, then run 'win7 export'"
  launch -drive "file=$WIN_ISO,if=ide,index=2,media=cdrom,readonly=on" -boot order=d
}

cmd_start() {
  running && { note "already running"; return 0; }
  [[ -f $SHARE_ISO ]] || build_share_iso
  launch -boot order=c
}

cmd_stop() {
  running || { note "not running"; return 0; }
  monitor_cmd "system_powerdown" >/dev/null
  note "sent ACPI shutdown; waiting up to 60s"
  local i
  for ((i = 0; i < 60; i++)); do running || { note "stopped"; return 0; }; sleep 1; done
  note "still running -- Windows may be asking something; force with: kill $(<"$PIDFILE")"
}

cmd_status() {
  if running; then
    echo "running (pid $(<"$PIDFILE"))"
  else
    echo "stopped"
  fi
  echo "disk:     $DISK ($(du -h "$DISK" 2>/dev/null | cut -f1) used)"
  echo "share:    $SHARE_ISO"
  ls -1 "$SHARE_DIR" 2>/dev/null | sed 's/^/            /'
}

cmd_snapshot() { [[ -n ${1:-} ]] || die "usage: win7 snapshot <name>"; qemu-img snapshot -c "$1" "$DISK" && note "snapshot '$1' saved"; }
cmd_restore()  { [[ -n ${1:-} ]] || die "usage: win7 restore <name>"; running && die "stop the VM first"; qemu-img snapshot -a "$1" "$DISK" && note "restored '$1'"; }

command -v qemu-system-x86_64 >/dev/null || die "qemu-system-x86_64 not installed"
mkdir -p "$VM_DIR" "$SHARE_DIR"

action=${1:-status}; shift || true
case "$action" in
  install)  cmd_install "$@" ;;
  start)    cmd_start "$@" ;;
  stop)     cmd_stop "$@" ;;
  status)   cmd_status "$@" ;;
  export)   cmd_export "$@" ;;
  snapshot) cmd_snapshot "$@" ;;
  restore)  cmd_restore "$@" ;;
  *) die "usage: win7 {install|start|stop|status|export|snapshot|restore}" ;;
esac
